# Copy to config.env:  cp config.env.example config.env   (config.env is gitignored). Nothing here is a secret.

# --- AWS ---
AWS_REGION=us-east-1
# Optional: named profile from ~/.aws/config (leave empty to use default credentials)
AWS_PROFILE=

# --- this stack (Amplify app only) ---
STACK_NAME=ingram-cost-ui

# --- the existing backend: HTTP API ingram_cost_calculator_api, route /invoke-agent on stage prod ---
COST_API_URL=https://w2ydw8uim4.execute-api.us-east-1.amazonaws.com/prod/invoke-agent
