# Copy to config.env and fill in:  cp config.env.example config.env   (config.env is gitignored)
# scripts/deploy.sh reads it. Nothing here is a secret.
# --- AWS ---
AWS_REGION=us-east-1
# Optional: named profile from ~/.aws/config (leave empty to use default credentials)
AWS_PROFILE=
# --- names ---
STACK_NAME=ingram-cost              # the one CloudFormation stack (UI, API, worker, runtime, table)
ECR_REPOSITORY=ingram-cost-agent    # agent image repository (created by scripts/deploy.sh)
RUNTIME_NAME=ingram_cost_agent      # AgentCore Runtime name (letters, digits, underscores)
# --- model (Bedrock inference profile; model access must be enabled) ---
MODEL_ID=global.anthropic.claude-sonnet-5-5                    # estimate agent, checklist extractor, coverage judge
INFERENCE_PROFILE_PATTERN=global.anthropic.claude-sonnet-5-5   # IAM allow-list; global.anthropic.* also allows other Claude models
MAX_OUTPUT_TOKENS=32000                                        # build_estimate carries the whole estimate as JSON
# --- cost guards for the open API (no sign-in): estimates (each is several Bedrock calls) ---
RUNS_PER_DAY=40            # all callers together
RUNS_PER_IP_HOUR=6         # one caller IP
# --- Web UI ---
# The UI is hosted on AWS Amplify (URL printed by deploy.sh). This extra origin is only
# allowed by CORS so you can run the UI locally.
UI_ORIGIN=http://localhost:5173
# Extra origins allowed to call the API (CORS), comma-separated, no trailing slash.
CORS_EXTRA_ORIGINS=
