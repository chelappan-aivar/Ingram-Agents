# Copy to config.env:  cp config.env.example config.env   (config.env is gitignored). Nothing here is a secret.
# --- AWS ---
AWS_REGION=us-east-1
# Optional: named profile from ~/.aws/config (leave empty to use default credentials)
AWS_PROFILE=
# --- this stack (Amplify app only) ---
STACK_NAME=ingram-pipeline-ui
# --- the pipeline backend stack (../deployment/template.yaml, deployed with sam deploy) ---
API_STACK=ingram-pipeline
# --- CORS ---
# deploy.sh adds the Amplify URL (plus the origins below) to the backend API's CORS allow-list. It is additive and
# done out-of-band: also pass the same origins as UiOrigins to the backend's sam deploy so they survive a redeploy.
# Set to false to skip (the hosted UI cannot call the API until its origin is allowed).
UPDATE_API_CORS=true
# Local UI origin, for: python3 -m http.server 5173 --directory ui
UI_ORIGIN=http://localhost:5173
# Extra origins, comma-separated, no trailing slash.
CORS_EXTRA_ORIGINS=
