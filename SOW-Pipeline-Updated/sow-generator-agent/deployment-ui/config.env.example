# Copy to config.env:  cp config.env.example config.env   (config.env is gitignored). Nothing here is a secret.

# --- AWS ---
AWS_REGION=us-east-1
# Optional: named profile from ~/.aws/config (leave empty to use default credentials)
AWS_PROFILE=

# --- this stack (Amplify app only) ---
STACK_NAME=ingram-sow-ui

# --- the existing backend stack (API Gateway "sow-gen-agent" + invoker Lambda + AgentCore runtime) ---
SOW_API_STACK=SowGenAgent

# --- CORS ---
# deploy.sh adds the Amplify URL (plus the origins below) to the backend's CORS allow-list:
# the invoker Lambda's CORS_ALLOWED_ORIGINS and the OPTIONS responses of the POST routes.
# Set to false to skip (the hosted UI cannot call the API until the origin is allowed).
UPDATE_API_CORS=true
# Local UI origin, for: python3 -m http.server 5173 --directory ui
UI_ORIGIN=http://localhost:5173
# Extra origins, comma-separated, no trailing slash.
CORS_EXTRA_ORIGINS=
