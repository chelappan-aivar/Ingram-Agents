ontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1175" y="455" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-5-1040-740" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1040" y="740" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-6-240-905" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="905" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-7-1790-720" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1790" y="720" width="34" height="34" as="geometry"/></mxCell><mxCell id="legend-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1820" height="487" as="geometry"/></mxCell><mxCell id="legend-badge-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70.0" y="1040" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-1" value="&lt;div&gt;&lt;b&gt;Load the UI&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Static UI from Amplify Hosting; open API, one shared history.&lt;/div&gt;&lt;div&gt;- GET /templates is served by the runtime catalogue (cached 10 min).&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135.0" y="1038" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70.0" y="1144" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-2" value="&lt;div&gt;&lt;b&gt;Start a job&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- POST /generations, /edits or /checks (files base64 in JSON, up to 4.5 MB).&lt;/div&gt;&lt;div&gt;- Lambda takes per-IP (15/h) and daily (60) slots and writes JOB#/META queued.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135.0" y="1142" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70.0" y="1248" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-3" value="&lt;div&gt;&lt;b&gt;Hand off to the runtime&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- InvokeAgentRuntime with session sow-draft-&amp;lt;id&amp;gt; keeps the microVM warm&lt;/div&gt;&lt;div&gt;- for later edits and exports; the agent replies 'accepted' at once.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135.0" y="1246" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70.0" y="1352" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-4" value="&lt;div&gt;&lt;b&gt;Draft, check, edit&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Claude streams the SOW; architecture images are sent as image blocks.&lt;/div&gt;&lt;div&gt;- Rules check scope/pricing; AI review and the tool-using editor are optional.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135.0" y="1350" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960.0" y="1040" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-5" value="&lt;div&gt;&lt;b&gt;Persist and poll&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Inputs and .md to S3; markdown, progress and logs to DynamoDB every 2 s.&lt;/div&gt;&lt;div&gt;- UI polls GET /jobs/{id}; large results are read back from S3.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1025.0" y="1038" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960.0" y="1144" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-6" value="&lt;div&gt;&lt;b&gt;Export .docx&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- POST /exports/docx: runtime renders with python-docx and writes to S3;&lt;/div&gt;&lt;div&gt;- Lambda returns a 15-minute presigned URL for the browser.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1025.0" y="1142" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960.0" y="1248" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-7" value="&lt;div&gt;&lt;b&gt;Deploy&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- deploy.sh uploads the agent zip, runs sam deploy, sets CORS&lt;/div&gt;&lt;div&gt;- and uploads the UI to Amplify (CSP pinned to the API).&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1025.0" y="1246" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-lines" value="&lt;div&gt;&lt;b&gt;Line styles&lt;/b&gt;&lt;/div&gt;&lt;b&gt;Solid&lt;/b&gt;: request and data flow at run time&lt;br&gt;&lt;b&gt;Solid, two arrows&lt;/b&gt;: read and write&lt;br&gt;&lt;b&gt;Dashed gray&lt;/b&gt;: build and deploy time" style="text;html=1;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;fontSize=13;whiteSpace=wrap;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960.0" y="1352" width="330" height="96" as="geometry"/></mxCell><mxCell id="legend-notes" value="&lt;div&gt;&lt;i&gt;S3 private, TLS-only, SSE-S3, lifecycle: sow/jobs/ 30 d, sow/ 365 d.&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;DynamoDB PITR + SSE + TTL; both retained on stack delete.&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;No external integrations: upstream agent JSON arrives in the request body.&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;Open API: add a JWT authorizer (Entra ID) before confidential use.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1310.0" y="1348" width="510.0" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>