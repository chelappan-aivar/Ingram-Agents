# Copy to config.env and fill in:  cp config.env.example config.env   (config.env is gitignored)
# scripts/deploy.sh (full stack) and ./deploy.sh (local setup, tests, smoke) both read it. Nothing here is a secret.

# --- AWS ---
AWS_REGION=us-east-1
# Optional: named profile from ~/.aws/config (leave empty to use default credentials)
AWS_PROFILE=

# --- names ---
STACK_NAME=ingram-architecture              # the one CloudFormation stack (UI, API, worker, runtime, table, bucket)
ECR_REPOSITORY=ingram-architecture-agent    # agent image repository (created by scripts/deploy.sh)
RUNTIME_NAME=ingram_architecture_agent      # AgentCore Runtime name (letters, digits, underscores)
PROJECT_NAME=ingram-architecture-agent      # used by ./deploy.sh local-test for the local image name

# --- models (Bedrock cross-Region inference profiles; model access must be enabled) ---
ADR_MODEL_ID=us.anthropic.claude-sonnet-4-6       # ADR, revise and usage steps
DIAGRAM_MODEL_ID=us.anthropic.claude-sonnet-4-6   # diagram document path only (unused when drawing from a design)
INFERENCE_PROFILE_PATTERN=us.anthropic.claude-sonnet-4-6   # IAM allow-list; us.anthropic.* also allows other Claude models

# --- diagram behaviour ---
LAYOUT_ENGINE=elk          # elk | llm
ASSUMPTIONS_MODE=suggest   # suggest | draw | off
NAMED_SERVICES_ONLY=true   # true | false

# --- cost guards for the open API (no sign-in): new runs + revisions (each is 2 Bedrock calls) ---
RUNS_PER_DAY=40            # all callers together
RUNS_PER_IP_HOUR=6         # one caller IP

# --- Web UI ---
# The UI is hosted on AWS Amplify (URL printed by deploy.sh). This extra origin is only
# allowed by CORS so you can run the UI locally.
UI_ORIGIN=http://localhost:5173
# Extra origins allowed to call the API (CORS), comma-separated, no trailing slash.
CORS_EXTRA_ORIGINS=
