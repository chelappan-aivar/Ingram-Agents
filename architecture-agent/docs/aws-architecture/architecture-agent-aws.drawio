<mxCell id="e-ecr-runtime" value="pull image" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#666666;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="ecr" target="runtime"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e-dev-cfn" value="sam deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#666666;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="developer" target="cfn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e-dev-ecr" value="docker buildx push (linux/arm64)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;fontFamily=Helvetica;dashed=1;strokeColor=#666666;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="developer" target="ecr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1725" y="855" /><mxPoint x="1215" y="855" /></Array></mxGeometry></mxCell>
