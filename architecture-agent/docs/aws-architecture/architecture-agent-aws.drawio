<mxCell id="step-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="262" y="427" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="step-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="427" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="step-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1005" y="427" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="step-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1365" y="427" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="step-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920" y="545" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="step-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;labelBackgroundColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1680" y="640" width="28" height="28" as="geometry" /></mxCell>
<mxCell id="legend-bg" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;shape=mxgraph.basic.rect;fillColor2=none;strokeWidth=1;size=20;indent=5;fillColor=light-dark(#EDF3FF,#305363);strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="50" y="930" width="1740" height="400" as="geometry" /></mxCell>
<mxCell id="legend-badge-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="80" y="957" width="40" height="38" as="geometry" /></mxCell>
<mxCell id="legend-text-1" value="&lt;div&gt;&lt;b&gt;Load the UI&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Browser loads the static web UI from Amplify Hosting (security headers, no sign-in).&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="132" y="955" width="780" height="80" as="geometry" /></mxCell>
<mxCell id="legend-badge-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="80" y="1045" width="40" height="38" as="geometry" /></mxCell>
<mxCell id="legend-text-2" value="&lt;div&gt;&lt;b&gt;Start a run&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- POST /runs with pasted SRS text or one file (up to 4 MB) through the throttled HTTP API.&lt;/div&gt;&lt;div&gt;- API Lambda enforces per-IP (6/hour, hashed IP) and daily (40) caps, stores the SRS in S3.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="132" y="1043" width="780" height="80" as="geometry" /></mxCell>
<mxCell id="legend-badge-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="80" y="1133" width="40" height="38" as="geometry" /></mxCell>
<mxCell id="legend-text-3" value="&lt;div&gt;&lt;b&gt;Hand off to the worker&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- API Lambda writes the run to DynamoDB and invokes the worker asynchronously.&lt;/div&gt;&lt;div&gt;- The UI polls GET /runs/{id}; revisions use POST /runs/{id}/revise (up to 10).&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="132" y="1131" width="780" height="80" as="geometry" /></mxCell>
<mxCell id="legend-badge-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="80" y="1221" width="40" height="38" as="geometry" /></mxCell>
<mxCell id="legend-text-4" value="&lt;div&gt;&lt;b&gt;Run the agent step by step&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Worker calls InvokeAgentRuntime once per step, one session per version:&lt;/div&gt;&lt;div&gt;- extract_srs, generate_adr (or revise_adr), generate_diagram, estimate_usage.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="132" y="1219" width="780" height="80" as="geometry" /></mxCell>
<mxCell id="legend-badge-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="940" y="957" width="40" height="38" as="geometry" /></mxCell>
<mxCell id="legend-text-5" value="&lt;div&gt;&lt;b&gt;Call the model&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- ADR/revise and usage steps call Claude Sonnet 4.6 on Bedrock: 2 calls per version.&lt;/div&gt;&lt;div&gt;- The diagram is drawn in the container from the design (draw.io + ELK), no model call.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="992" y="955" width="780" height="80" as="geometry" /></mxCell>
<mxCell id="legend-badge-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="940" y="1045" width="40" height="38" as="geometry" /></mxCell>
<mxCell id="legend-text-6" value="&lt;div&gt;&lt;b&gt;Persist results&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Worker writes adr.md, spec.json, usage.json and diagram.png/svg/drawio to S3,&lt;/div&gt;&lt;div&gt;- status and activity log to DynamoDB. A failed diagram/usage step keeps the ADR.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="992" y="1043" width="780" height="80" as="geometry" /></mxCell>
<mxCell id="legend-badge-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=default;fontColor=#FFFFFF;fontStyle=1;fontSize=22;labelBackgroundColor=none;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="940" y="1133" width="40" height="38" as="geometry" /></mxCell>
<mxCell id="legend-text-7" value="&lt;div&gt;&lt;b&gt;Deploy&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- scripts/deploy.sh builds the arm64 image, pushes it to ECR (digest pinned), runs sam deploy,&lt;/div&gt;&lt;div&gt;- sets CORS, writes ui/config.js and uploads the UI to Amplify, then smoke-tests the runtime.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="992" y="1131" width="780" height="80" as="geometry" /></mxCell>
<mxCell id="legend-lines" value="&lt;div&gt;&lt;b&gt;Line styles&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Solid&lt;/b&gt;: request and data flow at run time&lt;/div&gt;&lt;div&gt;&lt;b&gt;Solid, two arrows&lt;/b&gt;: read and write&lt;/div&gt;&lt;div&gt;&lt;b&gt;Dashed gray&lt;/b&gt;: build and deploy time&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;fontSize=13;whiteSpace=wrap;rounded=1;fillColor=light-dark(#F5F5F5,#29393B);strokeColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="940" y="1220" width="380" height="90" as="geometry" /></mxCell>
<mxCell id="legend-notes" value="&lt;div&gt;&lt;i&gt;Agent runtime role: ECR pull, logs, X-Ray, metrics and Bedrock InvokeModel only.&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;No S3 or DynamoDB access: the agent is stateless.&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;S3 private, TLS-only, SSE; DynamoDB PITR + SSE + TTL. Both retained on stack delete.&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;Open API: add a JWT authorizer (Entra ID) before using confidential SRS.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1335" y="1220" width="440" height="100" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>