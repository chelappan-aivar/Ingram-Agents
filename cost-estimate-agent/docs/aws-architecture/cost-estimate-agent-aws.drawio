d="e11" value="sam deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;fontFamily=Helvetica;dashed=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev" target="cfn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="docker buildx push (linux/arm64)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;fontFamily=Helvetica;dashed=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev" target="ecr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1795" y="955"/><mxPoint x="1180" y="955"/></Array></mxGeometry></mxCell><mxCell id="step-1-125-300" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="125" y="300" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-2-240-455" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="455" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-3-735-455" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="735" y="455" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-4-965-455" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="965" y="455" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-5-1290-255" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1290" y="255" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-6-1380-470" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1380" y="470" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-7-880-700" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="880" y="700" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-8-1790-720" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1790" y="720" width="34" height="34" as="geometry"/></mxCell><mxCell id="legend-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1820" height="591" as="geometry"/></mxCell><mxCell id="legend-badge-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70.0" y="1040" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-1" value="&lt;div&gt;&lt;b&gt;Load the UI&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Static UI from Amplify Hosting (security headers, no sign-in).&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135.0" y="1038" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70.0" y="1144" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-2" value="&lt;div&gt;&lt;b&gt;Start an estimate&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- POST /runs {requirements (30–20,000 chars), title} through the throttled HTTP API.&lt;/div&gt;&lt;div&gt;- API Lambda applies per-IP and daily caps and writes RUN#/META queued.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135.0" y="1142" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70.0" y="1248" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-3" value="&lt;div&gt;&lt;b&gt;Hand off to the worker&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- API Lambda invokes the worker asynchronously (no retries).&lt;/div&gt;&lt;div&gt;- UI polls GET /runs/{id} every 5 s, up to 20 min.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135.0" y="1246" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70.0" y="1352" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-4" value="&lt;div&gt;&lt;b&gt;Run the agent&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Worker claims the run and calls InvokeAgentRuntime once {action: estimate}&lt;/div&gt;&lt;div&gt;- (session cost-run-&amp;lt;id&amp;gt;, 870 s read timeout).&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135.0" y="1350" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960.0" y="1040" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-5" value="&lt;div&gt;&lt;b&gt;Call the model&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Strands BedrockModel: checklist extraction, coverage judge and the agent loop.&lt;/div&gt;&lt;div&gt;- MAX_OUTPUT_TOKENS 32k so build_estimate is not truncated.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1025.0" y="1038" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960.0" y="1144" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-6" value="&lt;div&gt;&lt;b&gt;Build the estimate&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- The MCP server (npm, pre-installed in the image) saves a public&lt;/div&gt;&lt;div&gt;- calculator.aws estimate and returns its URL; validated in code.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1025.0" y="1142" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960.0" y="1248" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-7" value="&lt;div&gt;&lt;b&gt;Persist results&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Worker writes the summary to META and the full estimate JSON to RESULT.&lt;/div&gt;&lt;div&gt;- No S3: results fit in DynamoDB (capped at ~350 KB).&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1025.0" y="1246" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-8" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960.0" y="1352" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-8" value="&lt;div&gt;&lt;b&gt;Deploy&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- deploy.sh builds the arm64 image, pushes to ECR (digest pinned), runs sam deploy,&lt;/div&gt;&lt;div&gt;- sets CORS, writes ui/config.js, uploads the UI to Amplify and pings the runtime.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1025.0" y="1350" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-lines" value="&lt;div&gt;&lt;b&gt;Line styles&lt;/b&gt;&lt;/div&gt;&lt;b&gt;Solid&lt;/b&gt;: request and data flow at run time&lt;br&gt;&lt;b&gt;Solid, two arrows&lt;/b&gt;: read and write&lt;br&gt;&lt;b&gt;Dashed gray&lt;/b&gt;: build and deploy time" style="text;html=1;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;fontSize=13;whiteSpace=wrap;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960.0" y="1456" width="330" height="96" as="geometry"/></mxCell><mxCell id="legend-notes" value="&lt;div&gt;&lt;i&gt;Agent role: ECR pull, logs, X-Ray, metrics and Bedrock only (stateless).&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;Prices come from calculator.aws, not the AWS Price List API.&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;Calculator links are public to anyone who has them.&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;deployment-ui/ targets a legacy backend (ingram_cost_calculator_proxy); not shown.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1310.0" y="1452" width="510.0" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>