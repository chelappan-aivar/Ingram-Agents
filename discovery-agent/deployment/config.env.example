# Copy to config.env and fill in:  cp config.env.example config.env   (config.env is gitignored)
# scripts/deploy.sh reads it. Nothing here is a secret.
# --- AWS ---
AWS_REGION=us-east-1
# Optional: named profile from ~/.aws/config (leave empty to use default credentials)
AWS_PROFILE=
# --- names ---
STACK_NAME=ingram-discovery                 # the one CloudFormation stack (UI, API, runtime, table, data bucket)
RUNTIME_NAME=ingram_discovery_agent         # AgentCore Runtime name (letters, digits, underscores)
# --- models (Bedrock cross-Region inference profiles; model access must be enabled in the account) ---
EXTRACTION_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0   # explicit needs (whole corpus)
HIDDEN_SIGNALS_MODEL_ID=us.anthropic.claude-opus-5-5               # hidden signals + clarification resolution
SMALL_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0         # narrative, trimming, orchestrator
INFERENCE_PROFILE_PATTERN=us.anthropic.*                           # IAM allow-list for the three profiles above
# --- data bucket encryption ---
# Empty: SSE-KMS with the AWS managed key (aws/s3). Or the ARN of a customer-managed key in the same Region.
KMS_KEY_ARN=
# --- cost guards for the open API (no sign-in): a run is several Sonnet/Opus calls over the whole corpus ---
RUNS_PER_DAY=20            # all callers together
RUNS_PER_IP_HOUR=4         # one caller IP
# --- Web UI ---
# The UI is hosted on AWS Amplify (URL printed by deploy.sh). This extra origin is only
# allowed by CORS (API and data bucket) so you can run the UI locally.
UI_ORIGIN=http://localhost:5173
# Extra origins allowed to call the API and upload to the bucket (CORS), comma-separated, no trailing slash.
CORS_EXTRA_ORIGINS=
