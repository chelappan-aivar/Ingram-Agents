# Resources of the Discovery agent that are ALREADY deployed in AWS (created by hand, not by template.yaml).
# scripts/deploy_existing.py updates these in place and creates only what is missing (the Amplify web app).
# Nothing here is a secret. Any value can be overridden with an environment variable of the same name.
AWS_REGION=us-east-1
EXPECTED_ACCOUNT=455162169375
# data bucket (input/ work/ output/ code/), encrypted with the customer-managed KMS key set on the bucket
DATA_BUCKET=ingram-discovery-agent
# AgentCore Runtime (code zip from s3://DATA_BUCKET/code/)
RUNTIME_ID=ingram_discovery_agent-0ayW0REyxv
# API: HTTP API -> Lambda
API_ID=eaxi52af2c
LAMBDA_NAME=ingram_discovery_agent
API_ROLE_NAME=ingram_discovery_agent_api_role
# web UI: AWS Amplify Hosting (created on the first run when no app with this name exists)
AMPLIFY_APP_NAME=ingram-discovery-ui
# cost guards for the open API (no sign-in); enforced in the Lambda, state kept in the data bucket
RUNS_PER_DAY=20
RUNS_PER_IP_HOUR=4

# Pipeline: Intake Agent opportunities and their Live Assist calls as engagement documents (api/pipeline.py).
# The Live Assist API. Its access key is read from this Secrets Manager secret (only the name is stored here), so
# the page needs no key: anyone who can open the Discovery page sees the Intake and Live Assist data.
LIVE_ASSIST_API_URL=https://bg0681jeib.execute-api.us-east-1.amazonaws.com
LIVE_ASSIST_KEY_SECRET=lassist-dev/access-key
