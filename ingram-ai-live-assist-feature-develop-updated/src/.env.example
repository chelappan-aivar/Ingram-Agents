# Copy to .env for local runs. Deployed environments get these from
# deploy/deploy.sh (runtime and Lambda environment variables), not from .env.

# --- Shared --------------------------------------------------------------------
AWS_REGION=us-east-1
# Log level: DEBUG, INFO, WARNING (runtime and API Lambda)
LOG_LEVEL=INFO

# DynamoDB tables (runtime, API Lambda, replayer Lambda)
SESSION_TABLE_NAME=
TIMELINE_TABLE_NAME=

# --- Agent runtime (main.py) -------------------------------------------------------
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# AgentCore Memory id; empty keeps conversation history in process only
AGENTCORE_MEMORY_ID=
# Long-term memory across calls (deploy.sh creates <prefix>_ltm). Empty disables it.
LONG_TERM_MEMORY_ID=
# Days call data is kept (DynamoDB TTL, memory read filter). Default 180.
DATA_RETENTION_DAYS=180
# Seconds the worker waits after a turn before running, to group bursts
PROCESS_DEBOUNCE_SECONDS=1.0
# Folder for per-run prompt and message dumps (contain call text); empty disables
PROMPT_LOG_DIR=tmp

# --- API Lambda (api/) ---------------------------------------------------------------
# Runtime that receives events (also used by the replayer Lambda and CLI)
AGENTCORE_RUNTIME_ARN=
# Runtime endpoint
AGENTCORE_QUALIFIER=DEFAULT
# Secrets Manager secret holding the X-Access-Key value
ACCESS_KEY_SECRET=
# S3 bucket for uploaded recordings and audio
UPLOAD_BUCKET=
# Replayer Lambda that runs recording and audio sources
REPLAYER_FUNCTION=

# --- Live meetings (app/meeting_join.py, runs inside the agent) ---------------------
# The Vexa API key and transcription key are NOT configured here. The person starting a call types them in
# the console; they travel to the agent in one event and are kept in its memory for that meeting only.
# https://api.cloud.vexa.ai (hosted) or http://localhost:18056 (self-hosted); plain http only for localhost
VEXA_API_BASE=https://api.cloud.vexa.ai
# Seconds a draft sentence must stay unchanged before it is used without waiting for Vexa to confirm it
# (the speaker paused). 0 waits for confirmation only: slower, never uses an unconfirmed sentence.
VEXA_PROMOTE_AFTER_SECONDS=5

# --- Live meetings with Recall.ai (api/recall.py, runs in the API Lambda) -------------
# vexa (default): the runtime follows the meeting with a Vexa bot. recall: the API sends a Recall.ai bot and
# receives Recall's signed webhooks. Deployed environments get these from Terraform (lambda.tf).
MEETING_PROVIDER=vexa
# Recall workspace region: us-east-1, us-west-2 (pay as you go), eu-central-1 or ap-northeast-1
RECALL_REGION=us-west-2
# The https address Recall can reach this API on (the API Gateway address). Webhooks go to <it>/recall/transcript
PUBLIC_API_URL=
# Names of the Secrets Manager secrets holding the Recall API key and the workspace verification secret (whsec_...)
RECALL_API_KEY_SECRET=
RECALL_VERIFY_SECRET_NAME=
# prioritize_low_latency (English only, about 1-3 s) or prioritize_accuracy (Recall says minutes of delay)
RECALL_STREAMING_MODE=prioritize_low_latency
RECALL_LANGUAGE_CODE=en
# true gives the best speaker names; Recall says it can raise transcription cost when people talk over each other
RECALL_SEPARATE_STREAMS=true
# Local development only, instead of the two secret names above (never commit real values):
# RECALL_API_KEY=
# RECALL_VERIFY_SECRET=whsec_...

# --- Local development only ----------------------------------------------------------
# API dev server (python -m api.local): any key value, used instead of ACCESS_KEY_SECRET
# ACCESS_KEY=dev
# Send events to a local agent (python main.py) instead of AGENTCORE_RUNTIME_ARN
# AGENT_URL=http://localhost:8080
# Leave REPLAYER_FUNCTION empty locally to run sources in a background thread.

# --- Replayer Lambda (replayer/) -----------------------------------------------------
# Uses AWS_REGION, TIMELINE_TABLE_NAME, AGENTCORE_RUNTIME_ARN and AGENTCORE_QUALIFIER above.

# --- deploy/smoke.py -----------------------------------------------------------------
# Set by deploy.sh from Secrets Manager; set it yourself to run smoke.py directly.
# ILA_ACCESS_KEY=
