# Copy to deploy/config.<env>.env (for example deploy/config.dev.env) and edit.
# Every resource name starts with PREFIX, so several environments can share an account.

# 3-20 characters: lowercase letters, digits and hyphens, starting with a letter.
PREFIX=ila-dev
REGION=us-east-1

# Bedrock model (inference profile id). Model access must be enabled in the account.
MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Retention
# Call data (DynamoDB TTL, AgentCore memory events and facts, uploads). 31-365.
DATA_RETENTION_DAYS=180
MEMORY_EVENT_EXPIRY_DAYS=180
UPLOAD_EXPIRY_DAYS=180
LOG_RETENTION_DAYS=14

# AgentCore Runtime session limits
RUNTIME_IDLE_TIMEOUT_SECONDS=900
RUNTIME_MAX_LIFETIME_SECONDS=28800

# Worker: seconds to wait after a turn to group bursts
PROCESS_DEBOUNCE_SECONDS=1.0

# API Gateway throttling (requests per second, burst)
API_THROTTLE_RATE=20
API_THROTTLE_BURST=40

# Comma-separated browser origins for the React app, e.g. https://app.example.com
# Empty keeps CORS off on the API and the upload bucket. Re-run `up` after setting it.
CORS_ALLOW_ORIGINS=
