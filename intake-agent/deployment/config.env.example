# Copy to config.env and fill in. config.env is gitignored.

# --- AWS ---
AWS_REGION=us-east-1
STACK_NAME=ingram-intake
# Optional: named profile from ~/.aws/config (leave empty to use default credentials)
AWS_PROFILE=

# --- Microsoft Entra ID: app registration "Ingram Intake" ---
ENTRA_TENANT_ID=<directory-tenant-id>
ENTRA_CLIENT_ID=<application-client-id>
# Not used: sign-in is the Microsoft device-code flow, which needs no client secret.
# Kept only so you can switch back to the on-behalf-of design later.
ENTRA_CLIENT_SECRET=REPLACE_ME

# --- Agent ---
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
MAX_EMAILS=300

# --- Funding check: Microsoft Dynamics 365 (Dataverse) ---
# DYNAMICS_URL:
#   (empty)  demo store in DynamoDB
#   mock     mock Dynamics 365: a Dataverse-compatible Web API on Lambda with dummy tables (accounts,
#            opportunities, notes). The agent uses its real Dynamics client. Load dummy data with
#            python3 scripts/seed_dynamics.py after deploying. The other DYNAMICS_* values are ignored.
#   https:// your real Dynamics 365 environment
# The app below must be added in Power Platform admin center as an application user with a security role
# that can read/create opportunities, accounts and notes. See README "Funding check".
DYNAMICS_URL=
# Tenant of that app (empty = ENTRA_TENANT_ID)
DYNAMICS_TENANT_ID=
DYNAMICS_CLIENT_ID=
# Stored in Secrets Manager (ingram-intake/dynamics-client-secret) by deploy.sh; never put in the stack.
DYNAMICS_CLIENT_SECRET=
# Add each funding decision as a note on the Dynamics opportunity (true / false)
DYNAMICS_WRITE_BACK=true

# --- Web UI ---
# The UI is hosted on AWS Amplify (URL printed by deploy.sh). This extra origin is only
# allowed by CORS so you can run the UI locally.
UI_ORIGIN=http://localhost:5173

# Extra origins allowed to call the API (CORS), comma-separated, no trailing slash.
CORS_EXTRA_ORIGINS=
