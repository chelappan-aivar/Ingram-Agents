<mxfile host="app.diagrams.net"><diagram id="intake-ui" name="Intake (UI on demand)"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1780" pageHeight="890" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Project Catalyst · 01 Intake Agent (on demand)&lt;/b&gt;&lt;br&gt;Turns an email or CRM record into a 40-field intake record linked to source passages, a gap list with draft follow-up questions, and a MAP / MPE fit card&lt;br&gt;&lt;span style='font-size:13px;color:#545B64'&gt;Web UI (Amplify Hosting) → API Gateway → Lambda → AgentCore Runtime → Outlook + Bedrock · every step logged in DynamoDB&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="24" y="8" width="1500" height="68" as="geometry"/></mxCell><mxCell id="cloud" value="AWS Cloud" style="shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;fontStyle=1;fontSize=14;html=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="470" y="125" width="1005" height="580" as="geometry"/></mxCell><mxCell id="ac" value="Amazon Bedrock AgentCore" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#01A88D;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#01A88D;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1140" y="150" width="310" height="396" as="geometry"/></mxCell><mxCell id="ms" value="Microsoft 365" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EAF3FC;strokeColor=#0078D4;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;fontStyle=1;fontSize=13;fontColor=#0078D4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1530" y="150" width="230" height="250" as="geometry"/></mxCell><mxCell id="user" value="User" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="30" y="309" width="42" height="42" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;Intake Web UI&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#232F3E;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="100" y="190" width="260" height="276" as="geometry"/></mxCell><mxCell id="ui_signin" value="Signed in with Microsoft (Entra ID)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="112" y="216" width="236" height="18" as="geometry"/></mxCell><mxCell id="ui_add" value="+ Add opportunity" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D8102;fontColor=#1D8102;fontSize=9;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="250" y="197" width="98" height="18" as="geometry"/></mxCell><mxCell id="ui_prompt" value="Find opportunities in mail from the last:" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="112" y="256" width="236" height="20" as="geometry"/></mxCell><mxCell id="b1" value="1 day" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=1.5;strokeColor=#232F3E;fillColor=#FFFFFF;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="115" y="291" width="70" height="28" as="geometry"/></mxCell><mxCell id="b7" value="&lt;b&gt;7 days&lt;/b&gt;" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=1.5;strokeColor=#232F3E;fillColor=#232F3E;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="195" y="291" width="70" height="28" as="geometry"/></mxCell><mxCell id="b30" value="30 days" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fontSize=11;strokeWidth=1.5;strokeColor=#232F3E;fillColor=#FFFFFF;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="275" y="291" width="70" height="28" as="geometry"/></mxCell><mxCell id="ui_res" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;" vertex="1" parent="1"><mxGeometry x="115" y="333" width="230" height="121" as="geometry"/></mxCell><mxCell id="res_head" value="&lt;b&gt;Results&lt;/b&gt; · 7 days · done" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="125" y="337" width="210" height="16" as="geometry"/></mxCell><mxCell id="res_sub" value="40 emails read · &lt;b&gt;3 opportunities&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#545B64;" vertex="1" parent="1"><mxGeometry x="125" y="353" width="210" height="15" as="geometry"/></mxCell><mxCell id="opp" value="&lt;b&gt;Contoso Retail&lt;/b&gt; · AWS migration&lt;br&gt;Needs: 40 VMs, DR, BI dashboards&lt;br&gt;&lt;font color='#B0182B'&gt;&lt;b&gt;Missing information&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#1D8102;strokeWidth=1.2;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="123" y="373" width="214" height="74" as="geometry"/></mxCell><mxCell id="opp_hi" value="HIGH" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FFF4E5;strokeColor=#ED7100;fontColor=#B35900;fontSize=8;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="302" y="378" width="30" height="13" as="geometry"/></mxCell><mxCell id="gap1" value="budget" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#DD344C;fontColor=#B0182B;fontSize=9;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="131" y="424" width="42" height="15" as="geometry"/></mxCell><mxCell id="gap2" value="timeline" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#DD344C;fontColor=#B0182B;fontSize=9;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="177" y="424" width="50" height="15" as="geometry"/></mxCell><mxCell id="gap3" value="decision maker" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#FDECEA;strokeColor=#DD344C;fontColor=#B0182B;fontSize=9;fontStyle=1;spacing=0;" vertex="1" parent="1"><mxGeometry x="231" y="424" width="80" height="15" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;Amazon API Gateway&lt;/b&gt;&lt;br&gt;HTTP API · Entra ID auth&lt;br&gt;POST /runs · POST /opportunities&lt;br&gt;GET /runs/{id}" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=1.5;align=left;verticalAlign=middle;spacingTop=0;spacingLeft=62;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="500" y="290" width="250" height="80" as="geometry"/></mxCell><mxCell id="api_icon" value="" style="sketch=0;outlineConnect=0;fillColor=#E7157B;strokeColor=#ffffff;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="510" y="308.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="amp" value="&lt;b&gt;AWS Amplify Hosting&lt;/b&gt;&lt;br&gt;serves the web UI (HTTPS)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=1.5;align=left;verticalAlign=middle;spacingTop=0;spacingLeft=62;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="500" y="168" width="250" height="58" as="geometry"/></mxCell><mxCell id="amp_icon" value="" style="sketch=0;outlineConnect=0;fillColor=#DD344C;strokeColor=#ffffff;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.amplify;" vertex="1" parent="1"><mxGeometry x="510" y="175.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="lambda" value="&lt;b&gt;AWS Lambda&lt;/b&gt;&lt;br&gt;intake-api&lt;br&gt;run · add opportunity · get" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=1.5;align=left;verticalAlign=middle;spacingTop=0;spacingLeft=62;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="830" y="290" width="210" height="80" as="geometry"/></mxCell><mxCell id="lambda_icon" value="" style="sketch=0;outlineConnect=0;fillColor=#ED7100;strokeColor=#ffffff;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="840" y="308.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="idn" value="&lt;b&gt;AgentCore Identity&lt;/b&gt;&lt;br&gt;user token → Outlook token&lt;br&gt;(on-behalf-of)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;strokeWidth=1.5;align=left;verticalAlign=middle;spacingTop=0;spacingLeft=62;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1160" y="180" width="270" height="60" as="geometry"/></mxCell><mxCell id="idn_icon" value="" style="sketch=0;outlineConnect=0;fillColor=#01A88D;strokeColor=#ffffff;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="1"><mxGeometry x="1170" y="188.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="rt" value="&lt;b&gt;AgentCore Runtime&lt;/b&gt;&lt;br&gt;Intake agent (container)&lt;br&gt;runs in background, up to 8 h" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;strokeWidth=1.5;align=left;verticalAlign=top;spacingTop=6;spacingLeft=62;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1160" y="290" width="270" height="236" as="geometry"/></mxCell><mxCell id="rt_icon" value="" style="sketch=0;outlineConnect=0;fillColor=#01A88D;strokeColor=#ffffff;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;" vertex="1" parent="1"><mxGeometry x="1170" y="298" width="44" height="44" as="geometry"/></mxCell><mxCell id="s5a" value="&lt;span style=&quot;background-color:#01A88D;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;5a&lt;/span&gt;&amp;nbsp; &lt;b&gt;Capture (triage)&lt;/b&gt;&lt;br&gt;email, CRM record or notes · opportunity?" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F2FBF9;strokeColor=#01A88D;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1175" y="358" width="240" height="44" as="geometry"/></mxCell><mxCell id="s5b" value="&lt;span style=&quot;background-color:#01A88D;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;5b&lt;/span&gt;&amp;nbsp; &lt;b&gt;Structure: up to 40 fields&lt;/b&gt;&lt;br&gt;each linked to its source passage" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F2FBF9;strokeColor=#01A88D;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1175" y="414" width="240" height="44" as="geometry"/></mxCell><mxCell id="s5c" value="&lt;span style=&quot;background-color:#01A88D;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;5c&lt;/span&gt;&amp;nbsp; &lt;b&gt;Gaps + MAP / MPE fit card&lt;/b&gt;&lt;br&gt;one draft follow-up question per gap" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F2FBF9;strokeColor=#01A88D;strokeWidth=1.2;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontSize=10;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1175" y="470" width="240" height="44" as="geometry"/></mxCell><mxCell id="entra" value="&lt;b&gt;Microsoft Entra ID&lt;/b&gt;&lt;br&gt;app: Ingram Intake" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#005A9E;strokeWidth=1.5;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1550" y="180" width="190" height="60" as="geometry"/></mxCell><mxCell id="graph" value="&lt;b&gt;Microsoft Graph&lt;/b&gt;&lt;br&gt;Outlook mail of the&lt;br&gt;signed-in user (Mail.Read)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0078D4;strokeColor=#005A9E;strokeWidth=1.5;fontSize=11;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="1550" y="290" width="190" height="80" as="geometry"/></mxCell><mxCell id="ddb" value="&lt;b&gt;Amazon DynamoDB&lt;/b&gt;&lt;br&gt;table: intake-runs&lt;br&gt;runs · opportunities · logs" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C925D1;strokeWidth=1.5;align=left;verticalAlign=middle;spacingTop=0;spacingLeft=62;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="930" y="600" width="210" height="80" as="geometry"/></mxCell><mxCell id="ddb_icon" value="" style="sketch=0;outlineConnect=0;fillColor=#C925D1;strokeColor=#ffffff;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="940" y="618.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="br" value="&lt;b&gt;Amazon Bedrock&lt;/b&gt;&lt;br&gt;Claude&lt;br&gt;structured JSON output" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#01A88D;strokeWidth=1.5;align=left;verticalAlign=middle;spacingTop=0;spacingLeft=62;spacingRight=6;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1250" y="600" width="200" height="80" as="geometry"/></mxCell><mxCell id="br_icon" value="" style="sketch=0;outlineConnect=0;fillColor=#01A88D;strokeColor=#ffffff;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="1260" y="618.0" width="44" height="44" as="geometry"/></mxCell><mxCell id="ddb_note" value="&lt;b&gt;intake-runs&lt;/b&gt; (one table, pk + sk)&lt;br&gt;RUN#&amp;lt;id&amp;gt; · META → user, days, status, counts&lt;br&gt;RUN#&amp;lt;id&amp;gt; · EMAIL#&amp;lt;msg&amp;gt; → opportunity or skipped + reason&lt;br&gt;RUN#&amp;lt;id&amp;gt; · OPP#&amp;lt;thread&amp;gt; → requirements, missing info, confidence&lt;br&gt;RUN#&amp;lt;id&amp;gt; · LOG#&amp;lt;time&amp;gt; → agent steps, errors" style="shape=note;size=12;whiteSpace=wrap;html=1;fillColor=#FBF2FC;strokeColor=#C925D1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10.5;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="495" y="592" width="405" height="96" as="geometry"/></mxCell><mxCell id="steps" value="&lt;b&gt;How it works&lt;/b&gt;&lt;div style='margin-top:6px'&gt;&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;1&lt;/span&gt;&amp;nbsp; User signs in with Microsoft (Entra ID).&lt;/div&gt;&lt;div style='margin-top:6px'&gt;&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;2&lt;/span&gt;&amp;nbsp; Picks 1, 7 or 30 days → &lt;b&gt;POST /runs&lt;/b&gt; {days}.&lt;/div&gt;&lt;div style='margin-top:6px'&gt;&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;3&lt;/span&gt;&amp;nbsp; Lambda logs the run in DynamoDB, starts the Intake agent and returns run_id.&lt;/div&gt;&lt;div style='margin-top:6px'&gt;&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;4&lt;/span&gt;&amp;nbsp; Agent swaps the user's token for an Outlook token and reads that user's mail.&lt;/div&gt;&lt;div style='margin-top:6px'&gt;&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;5&lt;/span&gt;&amp;nbsp; For each email thread, the agent (with Claude on Bedrock):&lt;/div&gt;&lt;div style='margin-top:4px;margin-left:24px'&gt;&lt;span style=&quot;background-color:#01A88D;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;5a&lt;/span&gt;&amp;nbsp; &lt;b&gt;Captures&lt;/b&gt; the opportunity: is this a customer ask? Noise is skipped.&lt;/div&gt;&lt;div style='margin-top:4px;margin-left:24px'&gt;&lt;span style=&quot;background-color:#01A88D;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;5b&lt;/span&gt;&amp;nbsp; &lt;b&gt;Structures&lt;/b&gt; the requirements: customer, contact, needs, AWS services, timeline, budget, region.&lt;/div&gt;&lt;div style='margin-top:4px;margin-left:24px'&gt;&lt;span style=&quot;background-color:#01A88D;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;5c&lt;/span&gt;&amp;nbsp; &lt;b&gt;Flags&lt;/b&gt; missing information the seller must chase, with a confidence score.&lt;/div&gt;&lt;div style='margin-top:6px'&gt;&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;6&lt;/span&gt;&amp;nbsp; Agent saves every decision, each opportunity and the run status to DynamoDB.&lt;/div&gt;&lt;div style='margin-top:6px'&gt;&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;7&lt;/span&gt;&amp;nbsp; UI polls &lt;b&gt;GET /runs/{id}&lt;/b&gt; and lists the opportunities, with gaps flagged for the seller to review.&lt;/div&gt;&lt;div style='margin-top:8px'&gt;&lt;span style=&quot;background-color:#1D8102;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;+&lt;/span&gt;&amp;nbsp; &lt;b&gt;Add opportunity:&lt;/b&gt; the seller pastes notes or an email → &lt;b&gt;POST /opportunities&lt;/b&gt; → the agent runs 5a–5c on it and returns the result at once (no polling). Logged in DynamoDB.&lt;/div&gt;&lt;div style='margin-top:10px;color:#545B64'&gt;Why poll: API Gateway waits at most 30 s per request. 7- and 30-day runs take longer, so the agent works in the background and the UI reads progress from the same API.&lt;/div&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DBDB;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=8;fontSize=11;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="24" y="490" width="425" height="380" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#879196;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5072;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="ui"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;1&lt;/span&gt; sign in with Microsoft" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#0078D4;strokeWidth=1.5;dashed=1;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="ui" target="entra"><mxGeometry x="-0.45" relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="100"/><mxPoint x="1645" y="100"/></Array></mxGeometry></mxCell><mxCell id="e3" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;2&lt;/span&gt; POST /runs · /opportunities" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.4167;exitDx=0;exitDy=0;entryX=0;entryY=0.1875;entryDx=0;entryDy=0;" edge="1" parent="1" source="ui" target="api"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;7&lt;/span&gt; GET /runs/{id}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1D8102;strokeWidth=2;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.8125;exitDx=0;exitDy=0;entryX=1;entryY=0.5978;entryDx=0;entryDy=0;" edge="1" parent="1" source="api" target="ui"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;dashed=0;endArrow=block;endFill=1;startArrow=block;startFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="api" target="lambda"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="loads UI" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DD344C;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.0254;entryDx=0;entryDy=0;" edge="1" parent="1" source="amp" target="ui"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;3&lt;/span&gt; start agent" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1695;entryDx=0;entryDy=0;" edg