strokeWidth=2;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.1695;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rt" target="graph"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#01A88D;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s5a" target="s5b"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#01A88D;strokeWidth=1.5;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="s5b" target="s5c"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e14" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;5a–c&lt;/span&gt; capture · structure · flag" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#01A88D;strokeWidth=2;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#232F3E;labelBackgroundColor=#FFFFFF;exitX=0.7481;exitY=1;exitDx=0;exitDy=0;entryX=0.56;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rt" target="br"><mxGeometry x="0.6" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e15" value="&lt;span style=&quot;background-color:#232F3E;color:#FFFFFF;border-radius:8px;padding:0 5px;font-weight:bold;&quot;&gt;6&lt;/span&gt; save opportunities + logs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C925D1;strokeWidth=2;dashed=0;endArrow=block;endFill=1;startArrow=none;startFill=1;fontSize=11;fontColor=#232F3E;labelBac