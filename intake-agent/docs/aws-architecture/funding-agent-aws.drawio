tSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;fontFamily=Helvetica;" vertex="1" parent="aux"><mxGeometry x="326.0" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="aux-i3" value="AWS X-Ray&lt;div&gt;&lt;i&gt;traces&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.xray;fontFamily=Helvetica;" vertex="1" parent="aux"><mxGeometry x="466.0" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="data" value="Check state" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;dashed=1;fontStyle=1;fontSize=12;strokeColor=#666666;fontColor=#333333;container=1;collapsible=0;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="890" y="820" width="300" height="170" as="geometry"/></mxCell><mxCell id="data-i0" value="Amazon DynamoDB&lt;div&gt;&lt;i&gt;ingram-intake-runs&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;SESSION#, FUNDOPP#, FUNDCHK#,&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;FUNDLATEST#, QUOTA#&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;fontFamily=Helvetica;" vertex="1" parent="data"><mxGeometry x="126.0" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="deploy" value="Deployment" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;dashed=1;fontStyle=1;fontSize=12;strokeColor=#E7157B;fontColor=#E7157B;container=1;collapsible=0;arcSize=6;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1230" y="820" width="420" height="170" as="geometry"/></mxCell><mxCell id="deploy-i0" value="Amazon S3&lt;div&gt;&lt;i&gt;agent code zip&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#3F8624;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fontFamily=Helvetica;" vertex="1" parent="deploy"><mxGeometry x="46.0" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="deploy-i1" value="Lambda layer&lt;div&gt;&lt;i&gt;opportunity form +&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;Dynamics client&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fontFamily=Helvetica;" vertex="1" parent="deploy"><mxGeometry x="186.0" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="deploy-i2" value="AWS CloudFormation&lt;div&gt;&lt;i&gt;SAM template.yaml&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudformation;fontFamily=Helvetica;" vertex="1" parent="deploy"><mxGeometry x="326.0" y="40" width="48" height="48" as="geometry"/></mxCell><mxCell id="e1" value="HTTPS: load UI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;fontFamily=Helvetica;;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="amp"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="115" y="270"/></Array></mxGeometry></mxCell><mxCell id="e2" value="REST + polling" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;fontFamily=Helvetica;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="users" target="apigw"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="proxy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;fontFamily=Helvetica;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apigw" target="lambda"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="InvokeAgentRuntime" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;fontFamily=Helvetica;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lambda" target="rt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="InvokeModel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;fontFamily=Helvetica;;exitX=0.8;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rt" target="br"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1110" y="275"/></Array></mxGeometry></mxCell><mxCell id="e6" value="OData" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;fontFamily=Helvetica;;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;startArrow=classic;startFill=1;" edge="1" parent="1" source="rt" target="mock"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e7" value="create (ingr_ columns), list" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;fontFamily=Helvetica;;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;startArrow=classic;startFill=1;" edge="1" parent="1" source="lambda" target="mock"><mxGeometry x="0.55" relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="720"/><mxPoint x="1457" y="720"/></Array></mxGeometry></mxCell><mxCell id="e8" value="OAuth device code" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;fontFamily=Helvetica;;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="lambda" target="ms"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="375"/><mxPoint x="1795" y="375"/></Array></mxGeometry></mxCell><mxCell id="e9" value="sessions, checks, quotas" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;fontFamily=Helvetica;;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;startArrow=classic;startFill=1;" edge="1" parent="1" source="lambda" target="data"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="615" y="780"/><mxPoint x="965" y="780"/></Array></mxGeometry></mxCell><mxCell id="e10" value="FUNDCHK#, FUNDLATEST#" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;fontFamily=Helvetica;;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rt" target="data"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="970" y="750"/><mxPoint x="1070" y="750"/></Array></mxGeometry></mxCell><mxCell id="e11" value="later" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;fontFamily=Helvetica;dashed=1;;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="mock" target="dyn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e12" value="code zip + layer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;fontFamily=Helvetica;dashed=1;;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="deploy" target="rt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1335" y="790"/><mxPoint x="1128" y="790"/></Array></mxGeometry></mxCell><mxCell id="e13" value="sam deploy, seed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=1.5;strokeColor=#666666;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#232F3E;fontFamily=Helvetica;dashed=1;;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dev" target="deploy"><mxGeometry x="-0.3" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="step-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="125" y="300" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="455" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="515" y="395" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="770" y="455" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1196" y="470" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1195" y="226" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1135" y="745" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-8" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1790" y="815" width="34" height="34" as="geometry"/></mxCell><mxCell id="legend-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1080" width="1820" height="560" as="geometry"/></mxCell><mxCell id="legend-badge-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="1110" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-1" value="&lt;div&gt;&lt;b&gt;Load the UI and sign in&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Intake Agent desk (Amplify ingram-funding-desk) or funding.html. Sign-in with Microsoft&lt;/div&gt;&lt;div&gt;- (device code) is required: the flow reads and writes Dynamics. Sessions are SHA-256 hashed in DynamoDB.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135" y="1108" width="800" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="1214" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-2" value="&lt;div&gt;&lt;b&gt;Create or list opportunities&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- POST /funding/opportunities validates the intake form answers (113 questions) and&lt;/div&gt;&lt;div&gt;- creates the Dynamics opportunity with ingr_ columns. GET /funding/dynamics lists them with the latest decision.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135" y="1212" width="800" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="1318" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-3" value="&lt;div&gt;&lt;b&gt;Microsoft sign-in&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Lambda runs the Entra device-code flow for users. Real Dynamics uses client credentials&lt;/div&gt;&lt;div&gt;- for the agent&#x27;s app user; the client secret lives in Secrets Manager.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135" y="1316" width="800" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="1422" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-4" value="&lt;div&gt;&lt;b&gt;Start the checks&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- POST /funding/checks/batch (up to 25) queues FUNDCHK# items and calls InvokeAgentRuntime once;&lt;/div&gt;&lt;div&gt;- the agent answers at once and runs the checks in a background task, 4 at a time.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135" y="1420" width="800" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="1110" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-5" value="&lt;div&gt;&lt;b&gt;Fetch from Dynamics&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- The agent signs in (OAuth token), then GETs the opportunity with its 118 ingr_ columns and&lt;/div&gt;&lt;div&gt;- notes through the Dataverse Web API. Mock now; real Dynamics later with the same client code.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1025" y="1108" width="800" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="1214" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-6" value="&lt;div&gt;&lt;b&gt;Facts and decision&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Form columns give the facts first. Claude reads free text only when a fact is missing, and a&lt;/div&gt;&lt;div&gt;- fact counts only if its quote is in the text. The rules engine then applies segment → workload → ARR.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1025" y="1212" width="800" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="1318" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-7" value="&lt;div&gt;&lt;b&gt;Record and show&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- FUNDCHK# (full result), FUNDLATEST# (shared latest decision) and an &#x27;AWS funding check&#x27; note&lt;/div&gt;&lt;div&gt;- on the Dynamics opportunity. The desk polls and shows program, amount, path, facts and questions.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1025" y="1316" width="800" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-8" value="8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960" y="1422" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-8" value="&lt;div&gt;&lt;b&gt;Deploy and seed&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- deploy.sh builds the agent zip and shared layer, runs sam deploy (DYNAMICS_URL=mock adds the&lt;/div&gt;&lt;div&gt;- mock), publishes both UIs. seed_dynamics.py loads the 15 dummy opportunities through the Web API.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1025" y="1420" width="800" height="98" as="geometry"/></mxCell><mxCell id="legend-lines" value="&lt;div&gt;&lt;b&gt;Line styles&lt;/b&gt;&lt;/div&gt;&lt;b&gt;Solid&lt;/b&gt;: request and data flow at run time&lt;br&gt;&lt;b&gt;Solid, two arrows&lt;/b&gt;: read and write&lt;br&gt;&lt;b&gt;Dashed gray&lt;/b&gt;: build, deploy or later swap" style="text;html=1;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;fontSize=13;whiteSpace=wrap;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70" y="1530" width="360" height="96" as="geometry"/></mxCell><mxCell id="legend-notes" value="&lt;div&gt;&lt;i&gt;Decisions are deterministic code (agent/funding/rules.py); Claude never decides funding.&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;Choice columns: option value 100,000,000 + position; reading accepts a JSON answers note too.&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;Mock Dynamics: 3 DynamoDB tables, generated client secret, removed when DYNAMICS_URL is real.&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;Agent reaches Dynamics over HTTPS (NetworkMode PUBLIC, no VPC). OData: token, then GET opportunity + notes, POST note.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="470" y="1526" width="1360" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>