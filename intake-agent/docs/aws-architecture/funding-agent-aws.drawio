 width="48" height="48" as="geometry"/></mxCell><mxCell id="lambda" value="UI API" style="fillColor=#FFF2E8;strokeColor=#ED7100;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#ED7100;container=1;collapsible=0;shadow=1;strokeWidth=1.5;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="570" y="430" width="180" height="150" as="geometry"/></mxCell><mxCell id="lambda-i0" value="AWS Lambda&lt;div&gt;&lt;i&gt;ingram-intake-api&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;session, sign-in gate,&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;form validation, quotas&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fontFamily=Helvetica;" vertex="1" parent="lambda"><mxGeometry x="66.0" y="30" width="48" height="48" as="geometry"/></mxCell><mxCell id="rt" value="Intake Agent (funding check)" style="fillColor=#E0F2F1;strokeColor=#01A88D;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#01A88D;container=1;collapsible=0;shadow=1;strokeWidth=1.5;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="830" y="380" width="330" height="290" as="geometry"/></mxCell><mxCell id="rt-i0" value="Bedrock AgentCore Runtime&lt;div&gt;&lt;i&gt;ingram_intake_agent, action funding_batch&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock_agentcore;fontFamily=Helvetica;" vertex="1" parent="rt"><mxGeometry x="141.0" y="30" width="48" height="48" as="geometry"/></mxCell><mxCell id="rt-panel" value="&lt;b&gt;Background task per check (4 workers, up to 25)&lt;/b&gt;&lt;br&gt;• fetch: opportunity + notes from Dynamics (OData)&lt;br&gt;• facts: ingr_ form columns first (servers → VMs)&lt;br&gt;• Claude only when the columns leave a gap;&lt;br&gt;&amp;nbsp;&amp;nbsp;every quote checked word for word&lt;br&gt;• decide: rules engine (segment → workload → ARR)&lt;br&gt;• record: DynamoDB + note on the opportunity" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#232F3E;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#01A88D;rounded=1;arcSize=6;spacingLeft=6;spacingTop=2;spacingRight=4;fontFamily=Helvetica;" vertex="1" parent="rt"><mxGeometry x="12" y="143" width="306" height="135" as="geometry"/></mxCell><mxCell id="br" value="Foundation Models" style="fillColor=#E0F2F1;strokeColor=#01A88D;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#01A88D;container=1;collapsible=0;shadow=1;strokeWidth=1.5;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1260" y="205" width="170" height="140" as="geometry"/></mxCell><mxCell id="br-i0" value="Amazon Bedrock&lt;div&gt;&lt;i&gt;Claude Sonnet 4.5&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;free-text facts only&lt;/i&gt;&lt;/div&gt;" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;fontFamily=Helvetica;" vertex="1" parent="br"><mxGeometry x="61.0" y="30" width="48" height="48" as="geometry"/></mxCell><mxCell id="mock" value="Mock Dynamics 365 (Dataverse Web API v9.2)" style="fillColor=#F3F9FF;strokeColor=#007CBD;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#007CBD;container=1;collapsible=0;shadow=1;strokeWidth=1.5;arcSize=8;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1265" y="420" width="385" height="260" as="geometry"/></mxCell><mxCell id=