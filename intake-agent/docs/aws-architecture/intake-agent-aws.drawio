le;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="240" y="455" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-3-700-320" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="700" y="320" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-4-760-455" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="760" y="455" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-5-1170-455" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1170" y="455" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-6-1030-690" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1030" y="690" width="34" height="34" as="geometry"/></mxCell><mxCell id="step-7-1790-720" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=16;shadow=1;strokeWidth=2;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1790" y="720" width="34" height="34" as="geometry"/></mxCell><mxCell id="legend-bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDF3FF;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="1010" width="1820" height="487" as="geometry"/></mxCell><mxCell id="legend-badge-1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70.0" y="1040" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-1" value="&lt;div&gt;&lt;b&gt;Load the UI and get a session&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Static UI from Amplify Hosting; POST /session returns an anonymous token.&lt;/div&gt;&lt;div&gt;- DynamoDB stores only its SHA-256 (90-day sliding TTL).&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135.0" y="1038" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-2" value="2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70.0" y="1144" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-2" value="&lt;div&gt;&lt;b&gt;Start a run&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- POST /runs with Outlook days (1/7/30), CRM .csv/.xlsx and/or notes (.pdf/.docx).&lt;/div&gt;&lt;div&gt;- Lambda extracts upload text, applies per-IP and daily quotas, writes RUN#/META.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135.0" y="1142" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-3" value="3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70.0" y="1248" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-3" value="&lt;div&gt;&lt;b&gt;Connect Outlook (optional)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Lambda runs the Entra device-code flow; the refresh token is kept in the&lt;/div&gt;&lt;div&gt;- session item; a fresh Graph access token goes into the run payload.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135.0" y="1246" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-4" value="4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="70.0" y="1352" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-4" value="&lt;div&gt;&lt;b&gt;Start the agent&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- InvokeAgentRuntime (session intake-run-&amp;lt;id&amp;gt;); the agent answers at once&lt;/div&gt;&lt;div&gt;- and keeps working in a background task (up to 8 h lifetime).&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="135.0" y="1350" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-5" value="5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960.0" y="1040" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-5" value="&lt;div&gt;&lt;b&gt;Triage, match, extract&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Claude Sonnet 4.5 via Strands BedrockModel, forced tool → Pydantic output.&lt;/div&gt;&lt;div&gt;- Every field is backed by a source quote the code checks.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1025.0" y="1038" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-6" value="6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960.0" y="1144" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-6" value="&lt;div&gt;&lt;b&gt;Persist and poll&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- Agent writes EMAIL#, OPP#, LOG# and counts to DynamoDB.&lt;/div&gt;&lt;div&gt;- UI polls GET /runs/{id}; GET /runs lists history via GSI owner-created.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1025.0" y="1142" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-badge-7" value="7" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#007CBD;strokeColor=#FFFFFF;fontColor=#FFFFFF;fontStyle=1;fontSize=22;shadow=1;strokeWidth=2;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960.0" y="1248" width="48" height="48" as="geometry"/></mxCell><mxCell id="legend-text-7" value="&lt;div&gt;&lt;b&gt;Deploy&lt;/b&gt;&lt;/div&gt;&lt;div&gt;- deploy.sh zips the agent to the artifacts bucket, runs sam deploy,&lt;/div&gt;&lt;div&gt;- sets CORS and uploads the UI to Amplify (CSP pinned to the API).&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1025.0" y="1246" width="795.0" height="98" as="geometry"/></mxCell><mxCell id="legend-lines" value="&lt;div&gt;&lt;b&gt;Line styles&lt;/b&gt;&lt;/div&gt;&lt;b&gt;Solid&lt;/b&gt;: request and data flow at run time&lt;br&gt;&lt;b&gt;Solid, two arrows&lt;/b&gt;: read and write&lt;br&gt;&lt;b&gt;Dashed gray&lt;/b&gt;: build and deploy time" style="text;html=1;align=left;verticalAlign=top;spacingTop=4;spacingLeft=8;fontSize=13;whiteSpace=wrap;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="960.0" y="1352" width="330" height="96" as="geometry"/></mxCell><mxCell id="legend-notes" value="&lt;div&gt;&lt;i&gt;No S3 for run data, no CRM write-back: CRM records are uploaded files.&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;Agent reaches graph.microsoft.com directly (NetworkMode PUBLIC, no VPC).&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;DynamoDB PITR + SSE + TTL, retained on stack delete.&lt;/i&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;Open API (session checked in Lambda): add a JWT authorizer before wider use.&lt;/i&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1310.0" y="1348" width="510.0" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>