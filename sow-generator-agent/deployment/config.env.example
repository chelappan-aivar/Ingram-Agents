# Copy to config.env and fill in:  cp config.env.example config.env   (config.env is gitignored)
# scripts/deploy.sh reads it. Nothing here is a secret.

# --- AWS ---
AWS_REGION=us-east-1
# Optional: named profile from ~/.aws/config (leave empty to use default credentials)
AWS_PROFILE=

# --- names ---
STACK_NAME=ingram-sow                 # the one CloudFormation stack (UI, API, runtime, table, data bucket)
RUNTIME_NAME=ingram_sow_agent         # AgentCore Runtime name (letters, digits, underscores)

# --- models (Bedrock cross-Region inference profiles; model access must be enabled) ---
GENERATION_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0     # drafting + AI editor
VERIFICATION_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0   # AI reviewer (Check draft)
INFERENCE_PROFILE_PATTERN=us.anthropic.claude-sonnet-4-5-20250929-v1:0   # IAM allow-list; us.anthropic.* allows any Claude

# --- cost guards for the open API (no sign-in): generations + AI edits + AI reviews ---
RUNS_PER_DAY=60            # all callers together
RUNS_PER_IP_HOUR=15        # one caller IP

# --- data ---
DATA_RETENTION_DAYS=365    # SOW inputs, drafts and .docx files in the data bucket

# --- Web UI ---
# The UI is hosted on AWS Amplify (URL printed by deploy.sh). This extra origin is only
# allowed by CORS so you can run the UI locally.
UI_ORIGIN=http://localhost:5173
# Extra origins allowed to call the API (CORS), comma-separated, no trailing slash.
CORS_EXTRA_ORIGINS=
